---
import { responsive, type ImageRole } from '../lib/images';
interface Props {
  src: string; alt: string; width: number; height: number; role?: ImageRole;
  loading?: 'lazy' | 'eager'; fetchpriority?: 'high' | 'low' | 'auto'; class?: string; style?: string; sizes?: string;
}
const { src, alt, width, height, role = 'inline', loading = 'lazy', fetchpriority, class: className, style, sizes } = Astro.props;
const r = responsive(src, role);
---
<img src={r.src} srcset={r.srcset} sizes={r.srcset ? (sizes ?? r.sizes) : undefined} {alt} {width} {height} {loading} fetchpriority={fetchpriority} decoding="async" class={className} {style} />
