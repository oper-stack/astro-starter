---
import { SITE } from '../lib/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container site-footer__grid">
    <div>
      <p class="site-footer__brand">{SITE.name}</p>
      <p class="meta" style="max-width: 32ch; margin-top:.5rem;">{SITE.tagline}</p>
    </div>
    <nav aria-label="Footer, sections">
      <p class="eyebrow" style="margin-bottom:.6rem;">Sections</p>
      <ul>{SITE.nav.map((i) => <li><a href={i.href}>{i.label}</a></li>)}</ul>
    </nav>
    <nav aria-label="Footer, site">
      <p class="eyebrow" style="margin-bottom:.6rem;">Site</p>
      <ul>
        {SITE.footerNav.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
        <li><a href="/llms.txt">Index for AI agents</a></li>
        <li><a href="/sitemap-index.xml">Sitemap</a></li>
      </ul>
    </nav>
    <div>
      <p class="eyebrow" style="margin-bottom:.6rem;">Contact</p>
      {SITE.contact.email && <p style="margin:0;"><a href={`mailto:${SITE.contact.email}`}>{SITE.contact.email}</a></p>}
      {SITE.contact.whatsapp && <p style="margin:.3rem 0 0;"><a href={SITE.contact.whatsapp} rel="noopener" target="_blank">WhatsApp</a></p>}
    </div>
  </div>
  <div class="container meta" style="padding-block: 1rem 1.5rem; border-top: 1px solid var(--rule);">
    {year} {SITE.name}. Figures carry their source in the same paragraph; where none is named, treat the number as an example.
  </div>
</footer>

<style>
  .site-footer { margin-top: 4rem; border-top: 1px solid var(--rule); background: var(--paper-2); }
  .site-footer__grid { display: grid; gap: 2rem; padding-block: 2.5rem; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); }
  .site-footer__brand { font-family: var(--font-display); font-weight: 600; font-size: 1.2rem; margin: 0; }
  .site-footer ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .35rem; }
  .site-footer a { color: var(--ink-2); font-size: .93rem; }
</style>
