---
/** Renders the FAQ from frontmatter. Schema is emitted by the layout, never here, so it is never duplicated. */
interface Props { items: { question: string; answer: string }[]; title?: string }
const { items, title = 'Frequently asked questions' } = Astro.props;
---
<section aria-label="FAQ" class="faq">
  <h2>{title}</h2>
  {items.map((it) => (
    <details class="faq__item">
      <summary>{it.question}</summary>
      <p set:html={it.answer} />
    </details>
  ))}
</section>
<style>
  .faq__item { border-bottom: 1px solid var(--rule); padding: .35rem 0; }
  .faq__item summary { cursor: pointer; font-weight: 600; padding: .6rem 0; min-height: 44px; display: flex; align-items: center; list-style: none; }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary::after { content: '+'; margin-left: auto; color: var(--accent); font-weight: 400; font-size: 1.3rem; }
  .faq__item[open] summary::after { content: '\2212'; }
  .faq__item p { margin: 0 0 .9rem; color: var(--ink-2); }
</style>
