{
  "siteUrl": "https://isla-verde.example",
  "contentDir": "src/content",
  "buildDir": "dist",
  "publicDir": "public",
  "redirectsFile": "vercel.json",
  "agentIndex": "dist/llms.txt",
  "reportDir": ".gates",
  "collections": {
    "guides": {
      "url": "/guides/",
      "minWords": 700,
      "faq": 3,
      "commercial": true
    },
    "areas": {
      "url": "/areas/",
      "minWords": 500,
      "faq": 2,
      "commercial": true
    },
    "comparisons": {
      "url": "/comparisons/",
      "minWords": 500,
      "faq": 3,
      "commercial": true
    },
    "projects": {
      "url": "/projects/",
      "minWords": 120,
      "faq": 0,
      "commercial": false,
      "kind": "entity"
    },
    "news": {
      "url": "/news/",
      "minWords": 80,
      "faq": 0,
      "commercial": false,
      "kind": "news"
    }
  },
  "requiredFrontmatter": [
    "title",
    "description",
    "pubDate",
    "tags"
  ],
  "title": {
    "min": 40,
    "max": 60
  },
  "description": {
    "min": 70,
    "max": 160
  },
  "currency": [
    {
      "sign": "₡",
      "code": "CRC"
    }
  ],
  "brandWords": [
    "guide",
    "review"
  ],
  "placeNames": [
    "playa norte",
    "playa sur",
    "puerto viejo",
    "cerro alto"
  ],
  "fillerPatterns": [],
  "faqTemplates": [],
  "boilerplate": [
    "^this card records what the developer published",
    "^figures are the developer's own"
  ],
  "imageHosts": [
    "res.cloudinary.com"
  ],
  "claims": {
    "enabled": true,
    "allowedSources": [
      "isla verde statistics office",
      "central bank of isla verde",
      "isla verde land registry"
    ]
  },
  "failOn": "fail"
}
