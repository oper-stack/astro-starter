# Copy to .env and fill in what you use. Everything is optional.
# IndexNow key: any 32-character hex string you also publish at /<key>.txt (see scripts/indexnow.mjs).
INDEXNOW_KEY=
# Path to the Google service-account JSON with the Indexing API enabled for THIS site's own Cloud project.
GOOGLE_INDEXING_KEY_FILE=./google-indexing-key.json
